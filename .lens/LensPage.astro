---
// Renders a Lens layout file with this project's markup and tokens.
// Project-owned: adapt it to the project's components (see .lens/CLAUDE.md).
// Lens IDs are added in dev only. The Lens app injects its own bridge into the
// preview, so nothing here references Lens code.
import LensBlock from './LensBlock.astro';
import config from './lens.config.json';

interface Props {
  layout: { sections: { id: string; props: Record<string, any>; blocks: any[] }[] };
}

const { layout } = Astro.props;
const dev = import.meta.env.DEV;
const bps = config.breakpoints;

// One rule per breakpoint, generated from lens.config so the two never drift apart.
const place = (p: string) =>
  `grid-column:var(--l${p}-col)/span var(--l${p}-span);order:var(--l${p}-order);display:var(--l${p}-display)`;
const css = [
  `.lens-block{${place('')}}`,
  ...bps.map((b) => `@media (max-width:${b.maxWidth}px){.lens-block{${place(`-${b.name}`)}}}`),
].join('\n');
---
<style is:inline set:html={css}></style>
{layout.sections.map((s) => (
  <section
    class="lens-section"
    data-lens-id={dev ? s.id : undefined}
    data-lens-type={dev ? 'section' : undefined}
    aria-label={s.props.label || undefined}
    style={`--l-surface:var(--surface-${s.props.surface ?? 'base'});--l-pad:var(--space-${s.props.padding ?? 'lg'});--l-gap:var(--space-${s.props.gap ?? 'md'})`}
  >
    <div class="lens-grid" data-lens-grid={dev ? s.id : undefined}>
      {s.blocks.map((b) => <LensBlock block={b} />)}
    </div>
  </section>
))}

<style>
  .lens-section {
    background: var(--l-surface);
    padding: var(--l-pad);
  }
  .lens-grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    row-gap: var(--l-gap);
    /* Capped so twelve columns and eleven gaps always fit on a small screen. */
    column-gap: min(var(--l-gap), 4%);
    max-width: var(--measure-page, 80rem);
    margin-inline: auto;
  }
</style>
