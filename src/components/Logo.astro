---
// Forest medallion, flat. Decorative: the text next to it carries the name.
interface Props { size?: number; tile?: boolean; class?: string }
const { size = 40, tile = true, class: cls } = Astro.props;
const blade = "M37 28.5 C26 32, 14.5 24, 23 11.5 C21.5 20.5, 28 26.5, 37 28.5 Z";
---
<svg class:list={["logo", cls]} viewBox="0 0 64 64" width={size} height={size} aria-hidden="true" focusable="false">
  {tile && <rect width="64" height="64" rx="14" fill="#e6eedf" />}
  <circle cx="32" cy="32" r="26" fill="#1f4d34" />
  <circle cx="32" cy="32" r="21.5" fill="none" stroke="#7fae6a" stroke-width="1.2" />
  <circle cx="32" cy="32" r="19.5" fill="#2d6a46" />
  <g fill="#b9d89a">
    {[0, 120, 240].map((a) => <path d={blade} transform={`rotate(${a} 32 32)`} />)}
  </g>
  <g fill="#7fae6a">
    {[0, 60, 120, 180, 240, 300].map((a) => <circle cx="32" cy="8.5" r="1.3" transform={`rotate(${a} 32 32)`} />)}
  </g>
</svg>
