---
// Forest medallion logo, generated by scripts/make-logos.mjs (spec: docs/logo.md).
// mark: the blades on a tile (header, docs). bare: blades only. medallion: the full plate (footer).
import mark from "../assets/logo/mark-compact.svg?url";
import bare from "../assets/logo/mark-bare.svg?url";
import medallion from "../assets/logo/medallion-compact.svg?url";

interface Props { variant?: "mark" | "bare" | "medallion"; size?: number; class?: string }
const { variant = "mark", size = 40, class: cls } = Astro.props;
const src = { mark, bare, medallion }[variant];
---
<img class:list={["logo", cls]} src={src} width={size} height={size} alt="" />
