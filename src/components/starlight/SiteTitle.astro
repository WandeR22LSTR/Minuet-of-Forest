---
import { SITE_TITLE } from "../../../site.config.mjs";
import Logo from "../Logo.astro";
const home = import.meta.env.BASE_URL.replace(/\/?$/, "/");
---
<a href={home} class="site-title"><Logo size={36} />{SITE_TITLE}</a>
<style>
  .site-title { display: inline-flex; align-items: center; gap: 0.55rem; font-family: var(--font-display); color: var(--forest); text-decoration: none; font-size: 1.35rem; line-height: 1; white-space: nowrap; }
</style>
