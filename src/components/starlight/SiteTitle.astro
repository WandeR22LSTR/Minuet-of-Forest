---
import { SITE_TITLE } from "../../../site.config.mjs";
const home = import.meta.env.BASE_URL.replace(/\/?$/, "/");
---
<a href={home} class="site-title">{SITE_TITLE}</a>
<style>
  .site-title { font-weight: 700; color: var(--forest); text-decoration: none; font-size: var(--sl-text-h4); }
</style>
