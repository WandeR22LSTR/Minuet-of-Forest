---
import Base from "../layouts/Base.astro";
import Logo from "../components/Logo.astro";
import { url, copy } from "../lib/site";
---
<Base title={copy.not_found.title} description={copy.not_found.text}>
  <section class="hero">
    <Logo variant="bare" size={80} />
    <h1>{copy.not_found.title}</h1>
  </section>
  <p>{copy.not_found.text}</p>
  <p><a href={url("/")}>{copy.not_found.home}</a></p>
</Base>
