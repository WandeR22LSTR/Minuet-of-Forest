---
import Base from "../layouts/Base.astro";
import Logo from "../components/Logo.astro";
import { url } from "../lib/site";
---
<Base title="Lost in the woods" description="Page not found.">
  <section class="hero">
    <Logo size={80} tile={false} />
    <h1>Lost in the woods</h1>
