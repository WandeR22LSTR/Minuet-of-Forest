---
import { render } from "astro:content";
import Base from "../layouts/Base.astro";
import Logo from "../components/Logo.astro";
import { url, publishedPages } from "../lib/site";

const pages = await publishedPages();
const live = new Set(pages.map((p) => p.id));
const now = pages.find((p) => p.id === "now");
// "Now" snippet: the first section of the now page, if it is published.
const nowSnippet = now?.body?.split(/\n## /)[1]?.split("\n").filter(Boolean);
const cards = [
  { title: "Research", text: "Astrophysics research and interests.", href: live.has("research") ? "/research/" : undefined },
  { title: "Projects", text: "Things I run and build.", href: "/projects/" },
  { title: "Resume", text: "Web resume with a PDF download.", href: "/resume/" },
];
---
<Base>
  <section class="hero" aria-labelledby="intro">
    <Logo size={96} tile={false} />
    <div>
      <h1 id="intro">Hi, I'm Luca</h1>
      <p>Also known as WandeR. This site collects my research, projects and resume.</p>
    </div>
  </section>
  <ul class="cards">
    {cards.map((c) => (
      <li class="card">
        <h2>{c.href ? <a href={url(c.href)}>{c.title}</a> : c.title}</h2>
        <p>{c.text}</p>
        {!c.href && <p class="muted">Coming soon.</p>}
      </li>
    ))}
  </ul>
  {now && nowSnippet && (
    <section aria-labelledby="now">
      <h2 id="now">Now</h2>
      <p><strong>{nowSnippet[0]}:</strong> {nowSnippet.slice(1).join(" ")}</p>
      <p><a href={url("/now/")}>More on the now page</a></p>
    </section>
  )}
</Base>
