---
import { parse } from "yaml";
import raw from "../data/projects.yaml?raw";
import Base from "../layouts/Base.astro";
import { clean, url, copy, SHOW_DRAFTS } from "../lib/site";
import { getCollection } from "astro:content";

type Project = { name: string; status: "live" | "building"; summary?: string; link?: string; link_label?: string };
const projects = (clean(parse(raw)) ?? []) as Project[];
// Only link to docs pages that are actually built.
const docs = new Set((await getCollection("docs", ({ data }) => SHOW_DRAFTS || !data.draft)).map((d) => `/${d.id}/`));
const linkOk = (l?: string) => l && (!l.startsWith("/docs/") || docs.has(l) || l === "/docs/");
---
<Base title="Projects" description={copy.projects.description}>
  <h1>Projects</h1>
  <ul class="cards">
    {projects.map((p) => (
      <li class="card">
        <h2>{p.name}</h2>
        <p><span class="tag">{p.status}</span></p>
        {p.summary && <p>{p.summary}</p>}
        {linkOk(p.link) ? <p><a href={url(p.link!)}>{p.link_label ?? "[link label]"}</a></p> : <p><a href={url("/docs/")}>Docs</a></p>}
      </li>
    ))}
  </ul>
</Base>
